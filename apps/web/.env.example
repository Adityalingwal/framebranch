# Copy to apps/web/.env and adjust. NEVER put a real credential in this
# file — it is committed; .env is gitignored.
#
# Local (Homebrew Postgres, M7 lock B):
#   brew install postgresql@14
#   pg_ctl -D /opt/homebrew/var/postgresql@14 start
#   createdb framebranch
#   createdb framebranch_test
#   DATABASE_URL=... pnpm --filter @framebranch/web db:migrate
#
# Production (Neon, docs/09 Item 16) uses the SAME variable and the same
# URL shape — nothing in the code is Neon-specific:
#   DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgres://localhost:5432/framebranch

# The database the server tests truncate and rebuild. It MUST NOT be the
# same database as DATABASE_URL: the tests wipe every table between tests.
TEST_DATABASE_URL=postgres://localhost:5432/framebranch_test
